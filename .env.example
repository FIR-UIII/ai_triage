# ── DefectDojo ─────────────────────────────────────────────────────────────────
DD_API_URL=https://ddojo.dev.example.local
DD_API_KEY=your_api_key_here
DD_VERIFY_SSL=false

# ── Vector store (ChromaDB) ────────────────────────────────────────────────────
CHROMA_DIR=./rag/chroma_db_metadata
CHROMA_COLLECTION=example_collection
# Cosine similarity threshold for RAG match: [0.0, 1.0]
SIMILARITY_THRESHOLD=0.75
# Threshold for dedup check when adding new KB entries (stricter)
DEDUP_THRESHOLD=0.92

# ── LLM – local llama.cpp (default) ──────────────────────────────────────────
LLM_MODEL_PATH=./llm/Qwen3-4B.gguf
LLM_N_CTX=8192
LLM_N_THREADS=8
LLM_TEMPERATURE=0.2

# ── LLM – OpenAI-compatible API (overrides llama.cpp when set) ───────────────
# Ollama:       LLM_API_BASE_URL=http://localhost:11434/v1
# llama-server: LLM_API_BASE_URL=http://localhost:8080/v1
# LLM_API_BASE_URL=
# LLM_API_MODEL=qwen2.5:0.5b
# LLM_API_KEY=none

# ── Application ────────────────────────────────────────────────────────────────
CACHE_DIR=./cache
OUTPUT_DIR=./output
LOG_LEVEL=INFO
# Set to true to post triage results as comments back to DefectDojo
POST_COMMENTS=false
